// Sight — production data model (design specification)
//
// This schema is the contract for the production persistence layer. The demo
// currently serves static JSON from public/data/ (committed by the Python ML
// pipeline). In production, this same data shape moves to Postgres, populated
// by a nightly cron that runs the ML pipeline and ingests fresh balances
// through the banking adapter layer (see lib/data/banking-adapter.ts).
//
// To validate this schema without installing Prisma at runtime:
//   npx prisma validate --schema=prisma/schema.prisma
//
// The frontend never reads from Postgres directly — it consumes a derived
// JSON snapshot (the same JSON contract the demo uses), generated by an
// export job. This keeps the UI tier stateless and CDN-cacheable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Production: Vercel Postgres (Neon) or self-hosted Postgres
  // Demo: not used — UI reads public/data/*.json directly
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Multi-tenancy
// =============================================================================

// Every entity is scoped to a Tenant. Tenants are the unit of isolation —
// one fintech company = one tenant. Row-level security is enforced via
// tenantId on every query (see lib/db/tenancy.ts in production).
model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique // url-safe identifier, e.g., "novapay"
  name      String           // display name, e.g., "NovaPay"
  region    Region           // primary regulatory region
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts        Account[]
  transactions    Transaction[]
  forecasts       Forecast[]
  alerts          Alert[]
  users           TenantUser[]
  auditEvents     AuditEvent[]

  @@index([slug])
}

model TenantUser {
  id        String     @id @default(cuid())
  tenantId  String
  email     String
  role      UserRole
  createdAt DateTime   @default(now())
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

enum Region {
  CIS     // Kazakhstan, neighbors
  EU      // PSD2 territory
  MENA    // ОАЭ DIFC
  SEA     // Singapore MAS
  US
}

enum UserRole {
  CFO              // can approve large transfers, see full audit
  TREASURER        // can execute transfers, see all accounts
  ANALYST          // read-only, can comment
  COMPLIANCE       // audit-only, immutable history view
}

// =============================================================================
// Core treasury data
// =============================================================================

model Account {
  id          String      @id @default(cuid())
  tenantId    String
  externalId  String      // bank-provided account number / IBAN / etc.
  name        String      // display: "NovaPay USD · NYC"
  bank        String      // counterparty: "JPMorgan"
  currency    String      // ISO 4217: "USD", "EUR", "GBP"
  country     String      // ISO 3166-1 alpha-2: "US", "DE", "GB"
  // Geolocation for the Globe visualization. Latitude first, longitude second.
  latitude    Float
  longitude   Float
  // Floor: regulatory minimum (e.g., LCR requirement) or operational threshold.
  minBalance  Decimal     @db.Decimal(20, 2)
  type        AccountType
  // True if this account is actively monitored. False = archived/closed.
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  forecasts    Forecast[]
  // An account can be both source and destination of transfers.
  outgoing     Transfer[] @relation("from")
  incoming     Transfer[] @relation("to")
  alerts       Alert[]

  @@unique([tenantId, externalId])
  @@index([tenantId, isActive])
  @@index([tenantId, bank])
  @@index([tenantId, currency])
  @@index([tenantId, country])
}

enum AccountType {
  OPERATIONAL // active treasury / payments
  SETTLEMENT  // card scheme settlement (Visa / Mastercard)
  RESERVE     // regulatory reserve / LCR buffer
  FX_HEDGE    // FX hedging position
}

model Transaction {
  id            String     @id @default(cuid())
  tenantId      String
  accountId     String
  // Positive = inflow, negative = outflow. In account currency.
  amount        Decimal    @db.Decimal(20, 2)
  // Channel that moved the money. INTERNAL = self-transfer between own accounts.
  channel       Channel
  // Free-form party identifier (anonymized in PII-sensitive contexts).
  counterparty  String?
  timestamp     DateTime
  // Anomaly score from the IsolationForest filter (0..1, higher = more anomalous).
  // Set by the nightly ML pipeline (ml/scripts/anomaly.py).
  anomalyScore  Float?
  isAnomaly     Boolean    @default(false)
  // Optional Transfer if this txn represents an executed Sight recommendation.
  transferId    String?
  createdAt     DateTime   @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transfer Transfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)

  @@index([tenantId, accountId, timestamp])
  @@index([tenantId, isAnomaly])
  @@index([transferId])
}

enum Channel {
  SEPA_INSTANT
  SEPA_STANDARD
  SWIFT
  VISA
  MASTERCARD
  INTERNAL
}

model Forecast {
  id           String   @id @default(cuid())
  tenantId     String
  accountId    String
  date         DateTime // forecasted date (day granularity)
  // Predicted balance (point estimate = stacker output, in account currency).
  balance      Decimal  @db.Decimal(20, 2)
  // Conformal interval bounds (80% coverage by default, see ml/scripts/calibrate.py).
  p10          Decimal  @db.Decimal(20, 2)
  p90          Decimal  @db.Decimal(20, 2)
  // True for points in history (used for backtest UI), false for future.
  isHistorical Boolean
  // Which model won model selection (per-account winner from selection.json).
  modelVersion String   // "sight-v3-ensemble"
  modelChoice  String   // "stacker" | "prophet" | "lightgbm" | "arima" | "ets" | "chronos"
  generatedAt  DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, accountId, date])
  @@index([tenantId, accountId, isHistorical])
}

// =============================================================================
// Transfers, alerts, audit
// =============================================================================

model Transfer {
  id             String         @id @default(cuid())
  tenantId       String
  fromAccountId  String
  toAccountId    String
  channel        Channel
  // Source amount in source currency.
  amount         Decimal        @db.Decimal(20, 2)
  amountCurrency String
  // If FX-crossing: received amount and currency. Otherwise null.
  receivedAmount   Decimal?     @db.Decimal(20, 2)
  receivedCurrency String?
  status         TransferStatus
  // Where Sight surfaced this recommendation: alert / compass / optimizer / manual.
  origin         TransferOrigin
  // Identity of the human who approved this transfer (TENANT user).
  approvedByUserId String?
  // Reason string surfaced to the user, e.g., "Lifts NYC above min on day +3".
  reason         String?
  createdAt      DateTime       @default(now())
  executedAt     DateTime?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  from         Account      @relation("from", fields: [fromAccountId], references: [id])
  to           Account      @relation("to", fields: [toAccountId], references: [id])
  transactions Transaction[]
  alerts       Alert[]

  @@index([tenantId, status])
  @@index([tenantId, executedAt])
}

enum TransferStatus {
  RECOMMENDED  // Sight suggested, awaiting human approval
  PENDING      // approved, in-flight at the bank
  COMPLETED    // settled
  FAILED       // bank rejected
  CANCELLED    // human cancelled before execution
}

enum TransferOrigin {
  ALERT       // from useAlertsAt() shortfall recommendation
  COMPASS     // from sight-compass.ts banner
  OPTIMIZER   // from Liquidity Gradient solver
  MANUAL      // user-initiated ad-hoc transfer
}

model Alert {
  id                       String        @id @default(cuid())
  tenantId                 String
  accountId                String
  severity                 AlertSeverity
  // Date the predicted shortfall hits.
  predictedDate            DateTime
  // Magnitude of the predicted shortfall (positive number, in account currency).
  predictedDeficit         Decimal       @db.Decimal(20, 2)
  // 0..1 confidence derived from the forecast interval width on predictedDate.
  confidence               Float
  // Sight's recommended transfer to resolve this alert.
  recommendedTransferId    String?
  status                   AlertStatus   @default(OPEN)
  createdAt                DateTime      @default(now())
  acknowledgedAt           DateTime?
  resolvedAt               DateTime?

  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account              Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recommendedTransfer  Transfer? @relation(fields: [recommendedTransferId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, severity])
  @@index([tenantId, accountId, predictedDate])
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  EXECUTED      // human ran Execute on the recommendation
  DISMISSED     // human chose not to act
}

// =============================================================================
// Audit trail (immutable, append-only)
// =============================================================================

// Every action that touches money or alerts the regulator goes here.
// This table is append-only — there's no update or delete. Required for
// SOC 2 Type II (Y2 target) and ISO 27001 (Y3 target).
model AuditEvent {
  id        String          @id @default(cuid())
  tenantId  String
  eventType AuditEventType
  // The user (TenantUser.id) who performed the action.
  actorId   String?
  // Entity touched: account id, transfer id, alert id, etc.
  entityId  String
  // Free-form JSON payload — diff, parameters, IP, user agent, etc.
  payload   Json
  occurredAt DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventType, occurredAt])
  @@index([tenantId, entityId])
}

enum AuditEventType {
  TRANSFER_RECOMMENDED
  TRANSFER_APPROVED
  TRANSFER_EXECUTED
  TRANSFER_CANCELLED
  ALERT_ACKNOWLEDGED
  ALERT_DISMISSED
  ACCOUNT_CREATED
  ACCOUNT_ARCHIVED
  USER_LOGIN
  USER_INVITED
  FORECAST_GENERATED
  ANOMALY_DETECTED
}
