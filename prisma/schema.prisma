// Sight — production data model
//
// Development uses SQLite for zero-config local dev. The same schema runs on
// Postgres in production by changing the provider and DATABASE_URL — the
// fields below avoid Postgres-specific types (Decimal, Json, enums) so the
// schema stays portable.
//
// Postgres mapping notes:
//   - "Float" → use Postgres Decimal(20, 2) for money. SQLite stores as REAL.
//   - "String" enums → upgrade to native Postgres enums for type safety.
//   - "String" JSON payload columns → Postgres jsonb.
//
// To validate: npx prisma validate --schema=prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Multi-tenancy — one fintech company = one tenant
// =============================================================================

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  region    String   // CIS | EU | MENA | SEA | US
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  transactions Transaction[]
  forecasts    Forecast[]
  transfers    Transfer[]
  alerts       Alert[]
  users        TenantUser[]
  auditEvents  AuditEvent[]

  @@index([slug])
}

model TenantUser {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  role      String   // CFO | TREASURER | ANALYST | COMPLIANCE
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

// =============================================================================
// Core treasury data
// =============================================================================

model Account {
  id          String   @id // human-readable id matching seed data, e.g. "usd-nyc"
  tenantId    String
  externalId  String   // for future bank integrations (IBAN, account number)
  name        String   // display: "NovaPay USD · NYC"
  bank        String   // counterparty: "JPMorgan"
  currency    String   // ISO 4217: USD, EUR, GBP, SGD, CHF
  country     String   // ISO 3166-1 alpha-2
  latitude    Float
  longitude   Float
  minBalance  Float    // Postgres: Decimal(20, 2)
  type        String   // operational | settlement | reserve | fx_hedge
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  forecasts    Forecast[]
  outgoing     Transfer[]    @relation("from")
  incoming     Transfer[]    @relation("to")
  alerts       Alert[]

  @@unique([tenantId, externalId])
  @@index([tenantId, isActive])
  @@index([tenantId, bank])
  @@index([tenantId, currency])
  @@index([tenantId, country])
}

model Transaction {
  id           String   @id @default(cuid())
  tenantId     String
  accountId    String
  amount       Float    // signed: positive = inflow, negative = outflow
  channel      String   // SEPA_INSTANT | SEPA_STANDARD | SWIFT | VISA | MASTERCARD | INTERNAL
  counterparty String?
  timestamp    DateTime
  anomalyScore Float?
  isAnomaly    Boolean  @default(false)
  transferId   String?
  createdAt    DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transfer Transfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)

  @@index([tenantId, accountId, timestamp])
  @@index([tenantId, isAnomaly])
  @@index([transferId])
}

model Forecast {
  id           String   @id @default(cuid())
  tenantId     String
  accountId    String
  date         DateTime // forecasted date (day granularity)
  balance      Float
  p10          Float
  p90          Float
  isHistorical Boolean
  modelVersion String   // e.g., "sight-v3-ensemble"
  modelChoice  String   // stacker | prophet | lightgbm | arima | ets | chronos
  // SHAP top-5 features as JSON string. Postgres → jsonb.
  shapJson     String?
  generatedAt  DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, accountId, date])
  @@index([tenantId, accountId, isHistorical])
}

// =============================================================================
// Transfers, alerts, audit
// =============================================================================

model Transfer {
  id               String    @id @default(cuid())
  tenantId         String
  fromAccountId    String
  toAccountId      String
  channel          String    // SEPA | SWIFT | VISA | MASTERCARD | INTERNAL
  amount           Float
  amountCurrency   String
  receivedAmount   Float?    // null unless cross-currency
  receivedCurrency String?
  status           String    @default("RECOMMENDED") // RECOMMENDED | PENDING | COMPLETED | FAILED | CANCELLED
  origin           String    // ALERT | COMPASS | OPTIMIZER | MANUAL
  approvedByUserId String?
  reason           String?
  createdAt        DateTime  @default(now())
  executedAt       DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  from         Account       @relation("from", fields: [fromAccountId], references: [id])
  to           Account       @relation("to", fields: [toAccountId], references: [id])
  transactions Transaction[]
  alerts       Alert[]

  @@index([tenantId, status])
  @@index([tenantId, executedAt])
}

model Alert {
  id                    String    @id @default(cuid())
  tenantId              String
  accountId             String
  severity              String    // INFO | WARNING | CRITICAL
  predictedDate         DateTime
  predictedDeficit      Float
  confidence            Float
  recommendedTransferId String?
  status                String    @default("OPEN") // OPEN | ACKNOWLEDGED | EXECUTED | DISMISSED
  createdAt             DateTime  @default(now())
  acknowledgedAt        DateTime?
  resolvedAt            DateTime?

  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account             Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recommendedTransfer Transfer? @relation(fields: [recommendedTransferId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, severity])
  @@index([tenantId, accountId, predictedDate])
}

// =============================================================================
// Audit trail — append-only, no updates/deletes (enforced at the API layer)
// Required for SOC 2 Type II (Y2 target) and ISO 27001 (Y3 target).
// =============================================================================

model AuditEvent {
  id         String   @id @default(cuid())
  tenantId   String
  eventType  String   // TRANSFER_EXECUTED | ALERT_ACKNOWLEDGED | ACCOUNT_CREATED | etc.
  actorId    String?
  entityId   String
  payload    String   // JSON string (Postgres → jsonb)
  occurredAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventType, occurredAt])
  @@index([tenantId, entityId])
}
